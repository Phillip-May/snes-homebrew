        static uint8_t stable_port0;
        static uint8_t stable_port1;
  stable_port0 = (*(volatile uint8_t*)0x00F4);
  stable_port1 = (*(volatile uint8_t*)0x00F5);


        if (stable_port0 != comms_v) {
