static void debug_init(void) {
    volatile uint8_t *p = (volatile uint8_t*)0xFE00;
    for (uint16_t i = 0; i < 0xFE; i++)
        p[i] = 0;
    (*(volatile uint16_t*)0xFEFE) = 0;
}

static void debug_putc(char c) {
    uint16_t wp = (*(volatile uint16_t*)0xFEFE);
    if (wp < 0xFE) {
        ((volatile uint8_t*)0xFE00)[wp] = c;
        (*(volatile uint16_t*)0xFEFE) = wp + 1;
    }
}

void debug_print(const char *s) {
    while (*s)
        debug_putc(*s++);
}

void debug_println(const char *s) {
    debug_print(s);
    debug_putc('\n');
}

static char hex_nibble(uint8_t n) {
    n &= 0xF;
    return n < 10 ? '0' + n : 'A' + (n - 10);
}

void debug_hex8(uint8_t val) {
    debug_putc(hex_nibble(val >> 4));
    debug_putc(hex_nibble(val & 0xF));
}


void writeDSPREG(uint8_t reg, uint8_t value) {
    (*(volatile uint8_t*)0x00F2) = reg;
    (*(volatile uint8_t*)0x00F3) = value;
}

uint8_t readDSPREG(uint8_t reg) {
    (*(volatile uint8_t*)0x00F2) = reg;
    return (*(volatile uint8_t*)0x00F3);
}


