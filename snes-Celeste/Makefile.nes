#
# NES UNROM-512 build using llvm-mos
# UNROM-512: 16KB fixed PRG-ROM + 16KB switchable (up to 512KB total)
# Level data and music data are placed in switchable banks
#

PROJECT_NAME := nes-Celeste
BUILD_DIR    := build-nes

SRC_DIR      := src
PORT_DIR     := $(SRC_DIR)/port
SHARED_DIR   := shared/src
LIBFIX_DIR   := $(SRC_DIR)/libfixmath

LLVM_MOS_PATH ?= C:/llvm-mos
LLVM_MOS_PATH_WIN   := $(subst /,\,$(LLVM_MOS_PATH))
LLVM_MOS_PATH_POSIX := $(subst \,/,$(LLVM_MOS_PATH_WIN))
NES_CLANG_POSIX     := $(LLVM_MOS_PATH_POSIX)/bin/mos-clang.exe
NES_CONFIG_POSIX    := $(LLVM_MOS_PATH_POSIX)/bin/mos-nes-unrom-512.cfg

NES_CFLAGS   := -Os -flto -ffunction-sections -fdata-sections -fomit-frame-pointer -fno-common -fno-stack-protector -fno-math-errno -fno-trapping-math -fno-signaling-nans -Wall -Wextra -Wno-unused-parameter -std=c17
NES_PORT_CFLAGS := -Os -flto -ffunction-sections -fdata-sections -fomit-frame-pointer -funroll-loops -finline-functions -fno-strict-aliasing -fno-common -fno-stack-protector -fno-math-errno -fno-trapping-math -fno-signaling-nans -fno-signed-zeros -fno-rounding-math -Wall -Wextra -Wno-unused-parameter -std=c17
NES_INCLUDES := -I$(SRC_DIR) -I$(PORT_DIR) -I$(SHARED_DIR) -I$(LIBFIX_DIR) -Ipython -I$(LLVM_MOS_PATH_POSIX)/mos-platform/nes/include
NES_LDFLAGS  := '-Wl,-Map=$(BUILD_DIR)/celeste-nes.map' '-Wl,--gc-sections' '-Wl,--relax' '-Wl,--defsym=__chr_rom_size=0' '-Wl,--defsym=__chr_ram_size=8'
NES_LIBS     := -lneslib
# FamiStudio Sound Engine (compiled from CA65 source, placed in bank 7)

NES_ROM      := $(BUILD_DIR)/celeste-nes.nes
NES_ROM_TEMP := $(BUILD_DIR)/celeste-nes-temp.nes
NES_OBJECTS  := $(BUILD_DIR)/mainBankZero.o \
                $(BUILD_DIR)/nes_port.o \
                $(BUILD_DIR)/nes_level4_anim.o \
                $(BUILD_DIR)/nes_level4_flush.o \
                $(BUILD_DIR)/nes_title_flush.o \
                $(BUILD_DIR)/nes_title_flush_wrap.o \
                $(BUILD_DIR)/nes_chr_data.o \
                $(BUILD_DIR)/fix16.o \
                $(BUILD_DIR)/music_data.o \
                $(BUILD_DIR)/famistudio_engine.o

.PHONY: all clean info

all: $(NES_ROM)

$(BUILD_DIR):
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"

$(BUILD_DIR)/mainBankZero.o: $(SRC_DIR)/mainBankZero.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_PORT_CFLAGS) $(NES_INCLUDES) -D__NES__ -c '$(SRC_DIR)/mainBankZero.c' -o '$(BUILD_DIR)/mainBankZero.o' }"

$(BUILD_DIR)/nes_port.o: $(PORT_DIR)/nes.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_PORT_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes.c' -o '$(BUILD_DIR)/nes_port.o' }"

# Level 4 animation: separate TU, no LTO, so bank section attributes are respected
NES_NOLTO_CFLAGS := $(subst -flto,,$(NES_PORT_CFLAGS))
$(BUILD_DIR)/nes_level4_anim.o: $(PORT_DIR)/nes_level4_anim.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_NOLTO_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes_level4_anim.c' -o '$(BUILD_DIR)/nes_level4_anim.o' }"

$(BUILD_DIR)/nes_title_flush_wrap.o: $(PORT_DIR)/nes_title_flush_wrap.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_NOLTO_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes_title_flush_wrap.c' -o '$(BUILD_DIR)/nes_title_flush_wrap.o' }"

$(BUILD_DIR)/nes_title_flush.o: $(PORT_DIR)/nes_title_flush.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_NOLTO_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes_title_flush.c' -o '$(BUILD_DIR)/nes_title_flush.o' }"

$(BUILD_DIR)/nes_level4_flush.o: $(PORT_DIR)/nes_level4_flush.c
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_NOLTO_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes_level4_flush.c' -o '$(BUILD_DIR)/nes_level4_flush.o' }"

$(BUILD_DIR)/fix16.o: $(LIBFIX_DIR)/fix16.c
	@echo [NES] Compiling $<
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_CFLAGS) $(NES_INCLUDES) -c '$(LIBFIX_DIR)/fix16.c' -o '$(BUILD_DIR)/fix16.o' }"

# CHR data in PRG-ROM: separate TU, no LTO, so bank section attributes are respected
$(BUILD_DIR)/nes_chr_data.o: $(PORT_DIR)/nes_chr_data.c python/sprite_chr_combined.inc python/title_chr.inc
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_NOLTO_CFLAGS) $(NES_INCLUDES) -c '$(PORT_DIR)/nes_chr_data.c' -o '$(BUILD_DIR)/nes_chr_data.o' }"

# FamiTone2 objects with sections redirected to bank 7
# Pre-built by: scripts/build_ft2_bank7.sh (run once, or after llvm-mos update)
# Stored in src/assets/ft2_bank7/

$(BUILD_DIR)/famistudio_engine.o: $(SRC_DIR)/assets/famistudio_engine_bank7.s $(SRC_DIR)/assets/famistudio_engine.bin
	@echo [NES] Assembling FamiStudio engine
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' -c '$(SRC_DIR)/assets/famistudio_engine_bank7.s' -o '$(BUILD_DIR)/famistudio_engine.o' }"

$(BUILD_DIR)/music_data.o: $(SRC_DIR)/assets/music_data.s
	@echo [NES] Assembling music data
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' -c '$(SRC_DIR)/assets/music_data.s' -o '$(BUILD_DIR)/music_data.o' }"


$(NES_ROM_TEMP): $(NES_OBJECTS)
	@echo [NES] Linking $(NES_ROM_TEMP)
	@powershell -NoLogo -NoProfile -Command "& { if (-not (Test-Path '$(BUILD_DIR)')) { New-Item -ItemType Directory -Path '$(BUILD_DIR)' | Out-Null }; & '$(NES_CLANG_POSIX)' --config '$(NES_CONFIG_POSIX)' $(NES_LDFLAGS) '$(BUILD_DIR)/mainBankZero.o' '$(BUILD_DIR)/nes_port.o' '$(BUILD_DIR)/fix16.o' '$(BUILD_DIR)/nes_chr_data.o' '$(BUILD_DIR)/nes_level4_anim.o' '$(BUILD_DIR)/nes_level4_flush.o' '$(BUILD_DIR)/nes_title_flush.o' '$(BUILD_DIR)/nes_title_flush_wrap.o' '$(BUILD_DIR)/famistudio_engine.o' '$(BUILD_DIR)/music_data.o' $(NES_LIBS) -o '$(NES_ROM_TEMP)' }"

$(NES_ROM): $(NES_ROM_TEMP)
	@echo [NES] Setting horizontal mirroring in iNES header
	@powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File fix_ines_header.ps1 -InputFile '$(NES_ROM_TEMP)' -OutputFile '$(NES_ROM)'

clean:
	@powershell -NoLogo -NoProfile -Command "if (Test-Path '$(BUILD_DIR)') { Remove-Item -Recurse -Force '$(BUILD_DIR)' }"

info:
	@echo Project: $(PROJECT_NAME)
	@echo Build directory: $(BUILD_DIR)
	@echo LLVM-MOS path: $(LLVM_MOS_PATH)
	@echo Objects: $(NES_OBJECTS)
